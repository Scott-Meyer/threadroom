{
  "name": "threadroom",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "threadroom",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=24"
      }
    },
    "node_modules/threadroom-pi": {
      "resolved": "packages/pi-extension",
      "link": true
    },
    "node_modules/threadroom-service": {
      "resolved": "packages/service",
      "link": true
    },
    "packages/pi-extension": {
      "name": "threadroom-pi",
      "version": "0.1.0-beta.0",
      "engines": {
        "node": ">=24"
      },
      "peerDependencies": {
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*",
        "typebox": "*"
      }
    },
    "packages/service": {
      "name": "threadroom-service",
      "version": "0.1.0",
      "bin": {
        "threadroom-service": "bin/threadroom-service.js"
      },
      "engines": {
        "node": ">=24"
      }
    }
  }
}
